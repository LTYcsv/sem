{
  "name": "foresight-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "engine",
    "server",
    "web"
  ],
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "test": "vitest run",
    "sim": "tsx engine/sim/simulate.ts",
    "build": "npm run build -w web",
    "start": "npm run build && tsx server/src/main.ts",
    "serve": "tsx server/src/main.ts",
    "dev": "concurrently -k -n server,web \"tsx watch server/src/main.ts\" \"npm run dev -w web\"",
    "e2e": "tsx scripts/e2e.ts",
    "typecheck": "tsc -p engine && tsc -p server && tsc -p web --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
